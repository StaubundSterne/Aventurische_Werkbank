                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "page": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "url": {
                                        "type": "string",
                                        "format": "uri"
                                    }
                                }
                            }
                        }
                    },
                    "oneOf": [

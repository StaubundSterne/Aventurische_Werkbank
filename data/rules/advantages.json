                                        "required": [
                                            "id"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "title"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "target-id",
                                            "target-title"
                                        ]
                                    }
                                ],
                                "dependencies": {
                                    "target-id": [
                                        "target-title"
                                    ],
                                    "target-title": [
                                        "target-id"
                                    ]
                                }
                            }
                        },
                        "prerequisites": {
                            "type": "array",
                            "description": "Voraussetzungen und Ausschlussbedingungen.",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "type",
                                    "id",
                                    "condition"
                                ],
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "advantage",
                                            "disadvantage",
                                            "skill",
                                            "combat_technique",
                                            "special_ability"
                                        ]
                                    },
                                    "id": {
                                        "type": "string",
                                        "description": "Eindeutige Regel-ID des referenzierten Regelgegenstands."
                                    },
                                    "condition": {
                                        "type": "string",
                                        "enum": [
                                            "present",
                                            "not_present"
                                        ]
                                    }
                                }
                            }
                        },
                        "publications": {
                            "type": "array",
                            "description": "Publikationen, in denen der Vorteil beschrieben wird.",

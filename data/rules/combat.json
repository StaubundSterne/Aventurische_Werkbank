{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DSA 5 – Kampfregelreferenz",
  "description": "Integrierte Schema- und Datenreferenz für DSA-5-Kampfregeln.",
  "definitions": {
    "combatRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description",
        "attributeRules",
        "combatTechniques",
        "combatModifiers"
      ],
      "properties": {
        "id": {
          "const": "DSA5_COMBAT_RULES"
        },
        "version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "attributeRules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attackDefault",
            "attackWhips",
            "rangedDefault",
            "higherOfGEorKK"
          ],
          "properties": {
            "attackDefault": {
              "const": "MU"
            },
            "attackWhips": {
              "const": "FF"
            },
            "rangedDefault": {
              "const": "FF"
            },
            "higherOfGEorKK": {
              "const": true
            }
          }
        },
        "combatTechniques": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "attackAttribute",
              "parryAttribute",
              "ranged"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CT_[A-Z0-9_]+$"
              },
              "name": {
                "type": "string"
              },
              "attackAttribute": {
                "enum": ["MU", "FF"]
              },
              "parryAttribute": {
                "enum": ["GE", "KK", "GE_KK", null]
              },
              "ranged": {
                "type": "boolean"
              }
            }
          }
        },
        "combatModifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parryRounding",
            "pain",
            "multipleDefense"
          ],
          "properties": {
            "parryRounding": {
              "const": "ceil"
            },
            "pain": {
              "type": "object",
              "required": ["penaltyPerLevel"],
              "properties": {
                "penaltyPerLevel": {
                  "const": -1
                }
              }
            },
            "multipleDefense": {
              "type": "object",
              "required": [
                "penaltyPerAdditionalDefense",
                "firstDefensePenalty",
                "resetEachRound",
                "affectsBaseValue"
              ],
              "properties": {
                "penaltyPerAdditionalDefense": {
                  "const": -3
                },
                "firstDefensePenalty": {
                  "const": 0
                },
                "resetEachRound": {
                  "const": true
                },
                "affectsBaseValue": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  },
  "data": {
